# Secrets: never commit. .env holds real API keys; .env.example is the blank template.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local data and caches
data/
.cache/
*.db
*.sqlite
*.sqlite3
*.log
logs/

# Telegram session files are equivalent to credentials
*.session
*.session-journal

# Claude/AI conversation transcripts & session exports: NEVER commit.
# They can contain pasted API keys and private conversation text. A pre-commit
# hook (.githooks/pre-commit) blocks these as well. The GitHub *web* uploader
# bypasses both guards, so never drag a transcript into github.com.
# (If you ever truly need to track a .jsonl data file: git add -f <path>.)
# To remove a file already in history, see
# docs/runbooks/scrub-file-from-git-history.md
docs/exports/
*.jsonl
*session*.zip
*transcript*.zip
*conversation*.zip

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
