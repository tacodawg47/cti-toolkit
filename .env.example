# Copy this file to .env and fill in real values. .env is git-ignored.
# Variable names match the cti-skills plugin clients so their code ports cleanly.
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
URLSCAN_API_KEY=
ABUSECH_AUTH_KEY=
# GreyNoise: leave blank to use the keyless community endpoint (about 10 lookups/day)
GREYNOISE_API_KEY=
# Phase 2 (vulnerability intelligence), both optional.
# NVD: free key from https://nvd.nist.gov/developers/request-an-api-key raises the limit from 5 to 50 requests per 30 s.
NVD_API_KEY=
# GitHub: a fine-grained personal access token, repository access "Public repositories (read-only)",
# no account permissions. Raises code search from 10 to 30 per minute; unlocks nothing else.
GITHUB_TOKEN=
# VulnCheck: free community account at vulncheck.com -> API token. VulnCheck KEV and XDB.
VULNCHECK_API_KEY=
# ransomware.live PRO: free key from https://my.ransomware.live (group profiles with exploited CVEs; Phase 3 victims).
RANSOMWARELIVE_API_KEY=
# Scheduled feeds require direct approval, source review, per-source enabling
# and this worker switch. Default startup performs no scheduled collection.
SCHEDULED_FEEDS_ENABLED=false
# Bulk jobs also require individually reviewed/enabled provider registry entries.
BULK_ENRICHMENT_ENABLED=false
# Raw archives remain off until all limits and a private root under DATA_DIR
# are explicitly configured. Unknown/sensitive/restricted content is omitted.
ARCHIVE_ENABLED=false
# Explicit source handling decisions, not collection approval. JSON list.
ARCHIVE_PUBLIC_SOURCES=[]
ARCHIVE_ROOT=
ARCHIVE_RESPONSE_BYTES=
ARCHIVE_SOURCE_BYTES=
ARCHIVE_TOTAL_BYTES=
ARCHIVE_RETENTION_SECONDS=
